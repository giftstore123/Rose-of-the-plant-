<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>حديقة الورود 🌸</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Lemonada:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --pink:    #ec4899;
      --rose:    #f472b6;
      --purple:  #9333ea;
      --violet:  #a855f7;
      --lavender:#e9d5ff;
      --yellow:  #fde68a;
      --green:   #4ade80;
      --green-d: #16a34a;
    }

    html, body {
      width: 100%; height: 100dvh;
      overflow: hidden;
      font-family: 'Lemonada', sans-serif;
    }

    /* ━━━━━━━━━━━━━━━━ SPLASH ━━━━━━━━━━━━━━━━ */
    #splash {
      position: fixed; inset: 0; z-index: 200;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 0;
      background: linear-gradient(160deg, #fce7f3 0%, #ede9fe 50%, #fef9c3 100%);
      transition: opacity 1.1s ease, transform 1.1s ease;
    }
    #splash.out { opacity: 0; transform: scale(1.08); pointer-events: none; }

    .gift-emoji {
      font-size: clamp(80px, 18vw, 120px);
      animation: gift-bounce 2.2s ease-in-out infinite;
      cursor: pointer; line-height: 1;
    }
    @keyframes gift-bounce {
      0%,100% { transform: translateY(0) rotate(-4deg); }
      50%      { transform: translateY(-22px) rotate(4deg); }
    }

    .splash-title {
      font-size: clamp(24px, 6vw, 44px);
      font-weight: 700;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-top: 20px; text-align: center;
    }
    .splash-sub {
      font-size: clamp(13px, 3vw, 17px);
      color: var(--violet); margin-top: 10px; text-align: center;
    }

    .btn-open {
      margin-top: 36px;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      color: #fff; border: none;
      padding: clamp(12px,3vw,16px) clamp(32px,8vw,56px);
      border-radius: 50px;
      font-family: 'Lemonada', sans-serif;
      font-size: clamp(15px, 3.5vw, 19px); font-weight: 700;
      cursor: pointer; letter-spacing: 0.02em;
      box-shadow: 0 8px 32px rgba(147,51,234,0.3);
      animation: glow-btn 2.5s ease-in-out infinite;
      transition: transform 0.2s;
    }
    .btn-open:hover { transform: scale(1.05); }
    @keyframes glow-btn {
      0%,100% { box-shadow: 0 8px 32px rgba(147,51,234,0.3); }
      50%      { box-shadow: 0 8px 48px rgba(236,72,153,0.55); }
    }

    /* Floating stars on splash */
    .bg-star {
      position: absolute; pointer-events: none;
      color: #f59e0b; animation: twinkle var(--d,2s) ease-in-out infinite;
      font-size: var(--s, 18px); top: var(--t); left: var(--l);
      animation-delay: var(--del,0s);
    }
    @keyframes twinkle {
      0%,100%{ opacity:.25; transform: scale(1); }
      50%    { opacity:1;   transform: scale(1.4); }
    }

    /* ━━━━━━━━━━━━━━━━ GARDEN ━━━━━━━━━━━━━━━━ */
    #garden {
      position: fixed; inset: 0;
      background: linear-gradient(180deg,
        #fce7f3 0%,
        #ede9fe 35%,
        #fef3c7 72%,
        #fde68a 100%);
      display: none; overflow: hidden;
    }

    /* Clouds */
    .cloud {
      position: absolute; background: rgba(255,255,255,.75);
      border-radius: 100px;
      animation: drift var(--dur,30s) linear var(--del,0s) infinite;
      top: var(--t); width: var(--w,100px); height: var(--h,34px);
    }
    .cloud::before, .cloud::after {
      content:''; position: absolute; background: rgba(255,255,255,.75);
      border-radius: 50%;
    }
    .cloud::before { width:50%; height:160%; top:-50%; left:20%; }
    .cloud::after  { width:35%; height:130%; top:-30%; right:20%; }
    @keyframes drift {
      from { transform: translateX(-250px); }
      to   { transform: translateX(calc(100vw + 250px)); }
    }

    /* Particles */
    .particle {
      position: absolute; pointer-events: none;
      animation: float-up var(--dur,10s) linear forwards;
      font-size: var(--s,20px); opacity: 0;
      left: var(--l); bottom: 0;
    }
    @keyframes float-up {
      0%   { opacity:0; transform: translateY(0)      scale(.5); }
      10%  { opacity:1;                                          }
      90%  { opacity:1;                                          }
      100% { opacity:0; transform: translateY(-85vh) scale(1.1); }
    }

    /* Header */
    .garden-header {
      position: absolute; top: 22px; left: 50%; transform: translateX(-50%);
      text-align: center; z-index: 30; white-space: nowrap;
    }
    .garden-title {
      font-size: clamp(17px,4.5vw,28px); font-weight: 700; color: var(--purple);
      text-shadow: 0 2px 12px rgba(147,51,234,.15);
    }

    /* Progress dots */
    .progress {
      position: absolute; top: 70px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 14px; z-index: 30;
    }
    .pdot {
      width: 14px; height: 14px; border-radius: 50%;
      background: rgba(255,255,255,.45);
      border: 2px solid rgba(147,51,234,.3);
      transition: all .5s ease;
    }
    .pdot.done {
      background: var(--pink);
      border-color: var(--purple);
      box-shadow: 0 0 10px rgba(236,72,153,.5);
      transform: scale(1.15);
    }

    /* ─── GROUND & SOIL ─── */
    .ground {
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 150px;
      background: linear-gradient(to bottom, #7c5232, #4b2c17);
      border-radius: 100px 100px 0 0;
    }
    /* decorative grass blades */
    .ground::before {
      content: '';
      position: absolute; top: -14px; left: 0; right: 0; height: 20px;
      background: repeating-linear-gradient(
        90deg,
        transparent 0px, transparent 12px,
        #4ade80 12px, #4ade80 15px,
        transparent 15px, transparent 24px,
        #22c55e 24px, #22c55e 27px,
        transparent 27px, transparent 36px
      );
      border-radius: 6px;
    }

    .soil-patch {
      position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
      width: min(520px, 88vw); height: 74px;
      background: radial-gradient(ellipse 80% 60% at 50% 60%, #3d2410, #5a3820);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      box-shadow: inset 0 6px 18px rgba(0,0,0,.3), 0 4px 12px rgba(0,0,0,.2);
      transition: transform .15s ease, box-shadow .15s ease;
      user-select: none;
    }
    .soil-patch:hover:not(.done) { transform: translateX(-50%) scale(1.03); }
    .soil-patch:active:not(.done){ transform: translateX(-50%) scale(.97); }
    .soil-patch.done { cursor: default; }

    .soil-hint {
      color: rgba(255,255,255,.85); font-size: clamp(12px,3vw,15px);
      text-align: center; pointer-events: none;
      animation: soft-pulse 2.2s ease-in-out infinite;
    }
    @keyframes soft-pulse {
      0%,100%{ opacity:.8; } 50%{ opacity:1; }
    }

    /* ─── FLOWER SLOTS ─── */
    .flowers-row {
      position: absolute;
      bottom: 130px;
      left: 50%; transform: translateX(-50%);
      width: min(460px, 88vw);
      display: flex; justify-content: space-around;
      align-items: flex-end;
      z-index: 20;
    }

    .fslot {
      position: relative;
      width: 90px; height: 260px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: flex-end;
    }

    /* Seed */
    .seed {
      width: 14px; height: 9px;
      background: radial-gradient(ellipse, #c49a3c, #7a5c14);
      border-radius: 50%;
      transform: scale(0);
      transition: transform .5s cubic-bezier(.34,1.56,.64,1);
      flex-shrink: 0;
    }
    .seed.show { transform: scale(1); }

    /* Stem wrapper */
    .stem-wrap {
      width: 6px;
      height: 0;
      background: linear-gradient(to top, #2d6b14, #4ade80);
      border-radius: 3px;
      position: relative;
      transition: height 1.6s cubic-bezier(.34,1.2,.64,1);
      flex-shrink: 0;
    }
    .stem-wrap.grow { height: 110px; }

    /* Leaves */
    .leaf {
      position: absolute;
      width: 30px; height: 14px;
      border-radius: 50%;
      opacity: 0;
      transition: opacity .5s ease, transform .9s cubic-bezier(.34,1.56,.64,1);
    }
    .leaf-l {
      right: 5px; bottom: 30px;
      background: linear-gradient(135deg, #4ade80, #22c55e);
      transform: rotate(35deg) scale(0); transform-origin: right center;
    }
    .leaf-r {
      left: 5px; bottom: 52px;
      background: linear-gradient(135deg, #4ade80, #16a34a);
      transform: rotate(-35deg) scale(0); transform-origin: left center;
    }
    .stem-wrap.grow .leaf-l { opacity:1; transform: rotate(35deg)  scale(1); }
    .stem-wrap.grow .leaf-r { opacity:1; transform: rotate(-35deg) scale(1); }

    /* Flower head */
    .fhead {
      position: relative;
      width: 76px; height: 76px;
      flex-shrink: 0;
      transform: scale(0) rotate(-20deg);
      transition: transform 1.2s cubic-bezier(.34,1.56,.64,1);
    }
    .fhead.bloom { transform: scale(1) rotate(0deg); }

    /* Petals */
    .petal {
      position: absolute;
      width: 27px; height: 43px;
      border-radius: 50%;
      top: 50%; left: 50%;
      margin-left: -13.5px; margin-top: -43px;
      transform-origin: center bottom;
    }
    .petal:nth-child(1) { transform: rotate(0deg);   }
    .petal:nth-child(2) { transform: rotate(51.4deg);}
    .petal:nth-child(3) { transform: rotate(102.8deg);}
    .petal:nth-child(4) { transform: rotate(154.3deg);}
    .petal:nth-child(5) { transform: rotate(205.7deg);}
    .petal:nth-child(6) { transform: rotate(257.1deg);}
    .petal:nth-child(7) { transform: rotate(308.6deg);}

    .fcenter {
      position: absolute;
      width: 26px; height: 26px; border-radius: 50%;
      top: 50%; left: 50%; transform: translate(-50%,-50%);
      z-index: 3;
    }

    /* Wobbly sway animation after bloom */
    @keyframes flower-sway {
      0%,100%{ transform: scale(1) rotate(-4deg); }
      50%    { transform: scale(1) rotate(4deg);  }
    }
    .fhead.bloom { animation: flower-sway 4s ease-in-out 1.3s infinite; }

    /* Message card */
    .msg-card {
      position: absolute;
      bottom: calc(100% + 14px);
      left: 50%; transform: translateX(-50%) scale(0) translateY(14px);
      width: 200px;
      background: rgba(255,255,255,.92);
      backdrop-filter: blur(12px);
      border-radius: 22px;
      padding: 16px 14px;
      text-align: center;
      font-size: clamp(11px,2.5vw,13.5px);
      line-height: 1.8;
      color: #5b21b6;
      border: 1.5px solid rgba(168,85,247,.25);
      box-shadow: 0 8px 32px rgba(168,85,247,.18), 0 2px 8px rgba(168,85,247,.1);
      opacity: 0;
      transition: transform .9s cubic-bezier(.34,1.56,.64,1), opacity .5s ease;
      z-index: 50; pointer-events: none;
    }
    .msg-card.show {
      transform: translateX(-50%) scale(1) translateY(0);
      opacity: 1;
    }
    .msg-card .msg-emoji { font-size: 26px; display: block; margin-bottom: 8px; }

    /* ─── SPARKLES ─── */
    .sparkle {
      position: fixed; pointer-events: none; z-index: 999;
      font-size: 22px;
      animation: sparkle-out .9s ease forwards;
    }
    @keyframes sparkle-out {
      0%  { opacity:1; transform: translate(0,0)                    scale(1);   }
      100%{ opacity:0; transform: translate(var(--tx),var(--ty))    scale(.2);  }
    }

    /* Floating hearts after bloom */
    .fheart {
      position: fixed; pointer-events: none; z-index: 998;
      font-size: clamp(16px,3vw,22px);
      animation: heart-rise 3.2s ease-out forwards;
      opacity: 0;
    }
    @keyframes heart-rise {
      0%  { opacity:0; transform: translateY(0)     scale(.6); }
      15% { opacity:1; transform: translateY(-25px) scale(1);  }
      100%{ opacity:0; transform: translateY(-170px)scale(.8); }
    }

    /* ─── FINAL MESSAGE ─── */
    #final {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      background: rgba(147,51,234,.12);
      backdrop-filter: blur(6px);
      opacity: 0; pointer-events: none;
      transition: opacity 1s ease;
    }
    #final.show { opacity:1; pointer-events: all; }

    .final-card {
      background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(253,244,255,.96));
      border-radius: 36px; padding: clamp(30px,6vw,52px) clamp(24px,5vw,48px);
      max-width: min(500px, 90vw); width: 100%;
      text-align: center;
      border: 2px solid rgba(168,85,247,.2);
      box-shadow: 0 24px 64px rgba(168,85,247,.22), 0 4px 16px rgba(168,85,247,.1);
      transform: scale(.82) translateY(20px);
      transition: transform 1.1s cubic-bezier(.34,1.4,.64,1);
    }
    #final.show .final-card { transform: scale(1) translateY(0); }

    .final-flowers { font-size: 42px; margin-bottom: 16px; }
    .final-h { font-size: clamp(20px,5vw,30px); font-weight:700; color:var(--purple); margin-bottom:16px; }
    .final-p { font-size: clamp(13px,3vw,16.5px); color:#6b21a8; line-height:2.1; margin-bottom:10px; }
    .final-sig { font-size: 13px; color: var(--violet); margin-top: 6px; }

    .btn-share, .btn-reset {
      margin-top: 20px; border: none; border-radius: 50px; cursor: pointer;
      font-family: 'Lemonada', sans-serif; font-weight:700;
      font-size: clamp(13px,3vw,16px); padding: 13px 30px;
      transition: transform .2s, box-shadow .2s;
    }
    .btn-share { background: linear-gradient(135deg, var(--pink), var(--purple)); color:#fff;
                 box-shadow: 0 6px 22px rgba(147,51,234,.28); }
    .btn-reset { background: linear-gradient(135deg, #7c3aed, #4f46e5); color:#fff;
                 box-shadow: 0 6px 22px rgba(79,70,229,.25); margin-right: 10px; }
    .btn-share:hover, .btn-reset:hover { transform: translateY(-3px); }
  </style>
</head>
<body>

<!-- ══════════════════ SPLASH ══════════════════ -->
<div id="splash">
  <span class="bg-star" style="--t:8%;  --l:12%; --s:20px; --d:2.1s; --del:.0s">✦</span>
  <span class="bg-star" style="--t:14%; --l:75%; --s:15px; --d:2.8s; --del:.4s">✧</span>
  <span class="bg-star" style="--t:75%; --l:8%;  --s:22px; --d:1.9s; --del:.8s">✦</span>
  <span class="bg-star" style="--t:68%; --l:88%; --s:16px; --d:2.5s; --del:.2s">✧</span>
  <span class="bg-star" style="--t:88%; --l:30%; --s:18px; --d:2.3s; --del:1.1s">✦</span>
  <span class="bg-star" style="--t:5%;  --l:48%; --s:24px; --d:2.0s; --del:.6s">✧</span>
  <span class="bg-star" style="--t:40%; --l:5%;  --s:14px; --d:3.0s; --del:.3s">✦</span>
  <span class="bg-star" style="--t:35%; --l:92%; --s:19px; --d:2.4s; --del:.9s">✧</span>

  <div class="gift-emoji">🎁</div>
  <h1 class="splash-title">لديكِ هديّة...</h1>
  <p class="splash-sub">أهدي إليكِ حديقةً من الورود المليئة بالمشاعر 🌸</p>
  <button class="btn-open" onclick="openGarden()">افتح الهديّة ✨</button>
</div>

<!-- ══════════════════ GARDEN ══════════════════ -->
<div id="garden">
  <!-- Stars -->
  <span class="bg-star" style="--t:6%;  --l:10%; --s:18px; --d:2.2s; --del:0s">✦</span>
  <span class="bg-star" style="--t:10%; --l:80%; --s:14px; --d:2.8s; --del:.5s">✧</span>
  <span class="bg-star" style="--t:4%;  --l:50%; --s:22px; --d:2.0s; --del:1s">✦</span>
  <span class="bg-star" style="--t:18%; --l:92%; --s:16px; --d:3.1s; --del:.3s">✧</span>
  <span class="bg-star" style="--t:8%;  --l:65%; --s:20px; --d:2.5s; --del:.8s">✦</span>

  <!-- Clouds -->
  <div class="cloud" style="--t:12%; --w:130px; --h:38px; --dur:28s; --del:0s"></div>
  <div class="cloud" style="--t:19%; --w: 88px; --h:28px; --dur:38s; --del:-14s"></div>
  <div class="cloud" style="--t: 8%; --w:110px; --h:34px; --dur:32s; --del:-22s"></div>

  <!-- Header -->
  <div class="garden-header">
    <div class="garden-title">🌸 حديقة الورود 🌸</div>
  </div>

  <!-- Progress dots -->
  <div class="progress">
    <div class="pdot" id="pd0"></div>
    <div class="pdot" id="pd1"></div>
    <div class="pdot" id="pd2"></div>
  </div>

  <!-- Flowers row -->
  <div class="flowers-row" id="flowers-row">

    <!-- ── Flower 0: Pink Rose ── -->
    <div class="fslot" id="fs0">
      <div class="msg-card" id="mc0">
        <span class="msg-emoji">🌹</span>
        أنتِ كزهرة تفتّحت في بستان أيامي، تملئين حياتي عطراً ولوناً لا مثيل له.
      </div>
      <div class="fhead" id="fh0">
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #ffb3cf, #ec4899)"></div>
        <div class="fcenter" style="background:radial-gradient(circle, #fef9c3, #fde68a); box-shadow:0 0 12px rgba(253,230,138,.7)"></div>
      </div>
      <div class="stem-wrap" id="sw0">
        <div class="leaf leaf-l"></div>
        <div class="leaf leaf-r"></div>
      </div>
      <div class="seed" id="sd0"></div>
    </div>

    <!-- ── Flower 1: Sunflower ── -->
    <div class="fslot" id="fs1">
      <div class="msg-card" id="mc1">
        <span class="msg-emoji">🌻</span>
        ابتسامتكِ تضيء عالمي كنجوم تتلألأ في سماء ليلة هادئة وجميلة.
      </div>
      <div class="fhead" id="fh1">
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #fef9c3, #fbbf24)"></div>
        <div class="fcenter" style="background:radial-gradient(circle, #92400e, #6b2f0a); box-shadow:0 0 10px rgba(146,64,14,.4)"></div>
      </div>
      <div class="stem-wrap" id="sw1">
        <div class="leaf leaf-l" style="background:linear-gradient(135deg,#86efac,#22c55e)"></div>
        <div class="leaf leaf-r" style="background:linear-gradient(135deg,#86efac,#16a34a)"></div>
      </div>
      <div class="seed" id="sd1"></div>
    </div>

    <!-- ── Flower 2: Lavender Lily ── -->
    <div class="fslot" id="fs2">
      <div class="msg-card" id="mc2">
        <span class="msg-emoji">💜</span>
        كل لحظة معكِ هي هدية ثمينة أحفظها في أعمق صندوق ذكرياتي إلى الأبد.
      </div>
      <div class="fhead" id="fh2">
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="petal" style="background:radial-gradient(ellipse at 50% 30%, #f3e8ff, #a855f7)"></div>
        <div class="fcenter" style="background:radial-gradient(circle, #fef9c3, #f59e0b); box-shadow:0 0 12px rgba(245,158,11,.5)"></div>
      </div>
      <div class="stem-wrap" id="sw2">
        <div class="leaf leaf-l" style="background:linear-gradient(135deg,#6ee7b7,#059669)"></div>
        <div class="leaf leaf-r" style="background:linear-gradient(135deg,#6ee7b7,#047857)"></div>
      </div>
      <div class="seed" id="sd2"></div>
    </div>

  </div><!-- /flowers-row -->

  <!-- Ground -->
  <div class="ground">
    <div class="soil-patch" id="soil-patch" onclick="plantFlower(event)">
      <p class="soil-hint" id="soil-hint">🌱 اضغطي هنا لتزرعي ورداً</p>
    </div>
  </div>

</div><!-- /garden -->

<!-- ══════════════════ FINAL ══════════════════ -->
<div id="final">
  <div class="final-card">
    <div class="final-flowers">🌹🌻💜</div>
    <h2 class="final-h">أنتِ حديقتي كلها 🌸</h2>
    <p class="final-p">في كل وردةٍ أزهرت، كانت مشاعري تنمو معها.</p>
    <p class="final-p">أنتِ السرّ الجميل الذي يجعل كل يوم يستحق.</p>
    <p class="final-sig">— مع كل الحب ❤️</p>
    <div style="margin-top:24px">
      <button class="btn-reset" onclick="resetGarden()">ازرعي مجدداً 🌱</button>
      <button class="btn-share" onclick="shareGift()">شارك الهديّة 🎁</button>
    </div>
  </div>
</div>

<!-- ══════════════════ SCRIPT ══════════════════ -->
<script>
  let planted = 0;
  const TOTAL = 3;

  /* ── Open garden ── */
  function openGarden() {
    const splash = document.getElementById('splash');
    splash.classList.add('out');
    setTimeout(() => {
      splash.style.display = 'none';
      const garden = document.getElementById('garden');
      garden.style.display = 'block';
      startParticles();
    }, 1100);
  }

  /* ── Plant a flower ── */
  function plantFlower(e) {
    if (planted >= TOTAL) return;
    const idx = planted++;

    spawnSparkles(e.clientX, e.clientY);
    document.getElementById('pd' + idx).classList.add('done');

    /* Update hint text */
    const hint = document.getElementById('soil-hint');
    if (planted >= TOTAL) {
      hint.textContent = '🌸 الحديقة اكتملت!';
      document.getElementById('soil-patch').classList.add('done');
    } else {
      hint.textContent = '🌱 اضغطي مجدداً لتزرعي ورداً آخر';
    }

    const seed = document.getElementById('sd' + idx);
    const stem = document.getElementById('sw' + idx);
    const head = document.getElementById('fh' + idx);
    const msg  = document.getElementById('mc' + idx);

    /* 1. Seed */
    setTimeout(() => { seed.classList.add('show'); }, 120);

    /* 2. Stem grows (seed fades) */
    setTimeout(() => {
      seed.style.transition = 'opacity .4s ease';
      seed.style.opacity = '0';
      stem.classList.add('grow');
    }, 750);

    /* 3. Flower blooms */
    setTimeout(() => { head.classList.add('bloom'); }, 2300);

    /* 4. Message + hearts */
    setTimeout(() => {
      msg.classList.add('show');
      spawnHearts(idx);
    }, 3400);

    /* 5. Final reveal */
    if (planted >= TOTAL) {
      setTimeout(() => { document.getElementById('final').classList.add('show'); }, 5500);
    }
  }

  /* ── Sparkles on click ── */
  function spawnSparkles(cx, cy) {
    const emojis = ['✨','🌟','💫','⭐','🌸','💖','🌺'];
    for (let i = 0; i < 9; i++) {
      const el = document.createElement('div');
      el.className = 'sparkle';
      el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      const angle = (i / 9) * 360;
      const dist  = 55 + Math.random() * 45;
      el.style.setProperty('--tx', (Math.cos(angle * Math.PI/180) * dist) + 'px');
      el.style.setProperty('--ty', (Math.sin(angle * Math.PI/180) * dist - 30) + 'px');
      el.style.left = cx + 'px';
      el.style.top  = cy + 'px';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 950);
    }
  }

  /* ── Floating hearts after bloom ── */
  function spawnHearts(idx) {
    const slot = document.getElementById('fs' + idx);
    const rect = slot.getBoundingClientRect();
    const cx   = rect.left + rect.width / 2;
    const cy   = rect.top + 20;
    ['💕','🌸','💖','✨','🌺','💗'].forEach((em, i) => {
      const el = document.createElement('div');
      el.className  = 'fheart';
      el.textContent = em;
      el.style.left = (cx + (Math.random() - .5) * 90) + 'px';
      el.style.top  = cy + 'px';
      el.style.animationDelay = (i * 0.22) + 's';
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 4000);
    });
  }

  /* ── Ambient particles ── */
  function startParticles() {
    const pool = ['💖','✨','🌸','🌟','💫','🦋','🌺','💕','⭐','🌼'];
    setInterval(() => {
      const el = document.createElement('div');
      el.className = 'particle';
      el.textContent = pool[Math.floor(Math.random() * pool.length)];
      el.style.setProperty('--l',   (Math.random() * 100) + 'vw');
      el.style.setProperty('--s',   (13 + Math.random() * 16) + 'px');
      el.style.setProperty('--dur', (8  + Math.random() * 9)  + 's');
      document.getElementById('garden').appendChild(el);
      setTimeout(() => el.remove(), 18000);
    }, 1100);
  }

  /* ── Share ── */
  function shareGift() {
    const msg  = 'أهدي إليكِ هذه الحديقة الجميلة 🌸❤️';
    const url  = window.location.href;
    if (navigator.share) {
      navigator.share({ title: 'حديقة الورود 🌸', text: msg, url });
    } else if (navigator.clipboard) {
      navigator.clipboard.writeText(url);
      alert('تم نسخ الرابط! شاركيه مع من تحبين 🌸');
    }
  }

  /* ── Reset ── */
  function resetGarden() {
    planted = 0;
    document.getElementById('final').classList.remove('show');
    for (let i = 0; i < TOTAL; i++) {
      const seed = document.getElementById('sd' + i);
      seed.classList.remove('show');
      seed.style.opacity = '1';
      document.getElementById('sw' + i).classList.remove('grow');
      document.getElementById('fh' + i).classList.remove('bloom');
      document.getElementById('mc' + i).classList.remove('show');
      document.getElementById('pd' + i).classList.remove('done');
    }
    document.getElementById('soil-patch').classList.remove('done');
    document.getElementById('soil-hint').textContent = '🌱 اضغطي هنا لتزرعي ورداً';
  }
</script>
</body>
</html>
